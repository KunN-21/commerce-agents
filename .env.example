# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
#ANTHROPIC_API_KEY=

# Optional: route API calls through a custom Anthropic-compatible endpoint.
# ANTHROPIC_BASE_URL=https://example-llm-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=your-gateway-token

SHOPPING_MODEL=claude-opus-5
MERCHANT_MODEL=claude-opus-5
MERCHANT_ANALYSIS_MODEL=

MERCHANT_ANALYSIS_CODE_EXECUTION=0
